<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Labyrinth</RootNamespace>
    <AssemblyName>Labyrinth</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Die originale Properties\AssemblyInfo.cs verwenden statt sie generieren zu lassen -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- CA1416: Ohne generierte AssemblyInfo fehlt das SupportedOSPlatform-Attribut; die App ist ohnehin nur für Windows -->
    <NoWarn>$(NoWarn);WFO1000;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Update="App.config" />
  </ItemGroup>

</Project>
